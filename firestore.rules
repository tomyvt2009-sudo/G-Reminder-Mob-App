rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all unmatched reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCategory(category) {
      return category in ['Work', 'Personal', 'Errand', 'Health', 'Finance', 'General'];
    }

    function isValidReminder(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.topic is string &&
             data.topic.size() >= 1 &&
             data.topic.size() <= 100 &&
             data.organizedNote is string &&
             data.organizedNote.size() <= 2000 &&
             data.rawTranscript is string &&
             data.rawTranscript.size() <= 2000 &&
             data.category is string &&
             isValidCategory(data.category) &&
             (!('scheduledAtEpochMillis' in data) ||
              data.scheduledAtEpochMillis == null ||
              (data.scheduledAtEpochMillis is int && data.scheduledAtEpochMillis >= 0)) &&
             data.completed is bool &&
             (!('completedAtEpochMillis' in data) ||
              data.completedAtEpochMillis == null ||
              (data.completedAtEpochMillis is int && data.completedAtEpochMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isEditContentAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'topic',
        'organizedNote',
        'category',
        'scheduledAtEpochMillis',
        'updatedAt'
      ]);
    }

    function isToggleCompleteAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'completed',
        'completedAtEpochMillis',
        'updatedAt'
      ]);
    }

    match /users/{userId}/reminders/{reminderId} {
      allow get: if isOwner(userId) && isValidId(reminderId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(reminderId) &&
                       incoming().keys().hasAll([
                         'userId',
                         'topic',
                         'organizedNote',
                         'rawTranscript',
                         'category',
                         'completed',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'topic',
                         'organizedNote',
                         'rawTranscript',
                         'category',
                         'scheduledAtEpochMillis',
                         'completed',
                         'completedAtEpochMillis',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidReminder(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(reminderId) &&
                       isValidReminder(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().rawTranscript == existing().rawTranscript &&
                       (isEditContentAction() || isToggleCompleteAction());

      allow delete: if isOwner(userId) && isValidId(reminderId);
    }
  }
}
